# ==============================================================================
# Media Source Aggregator & Telegram Bot Configuration
# ==============================================================================

# --- Telegram Bot Credentials ---
# Telegram Bot Token obtained from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Trusted Administrator Telegram User IDs (comma-separated positive integers)
# Only users listed here are granted administrative rights and can authorize other users.
TELEGRAM_ADMIN_IDS=123456789,987654321

# Bot Operating Mode: "personal" or "multi-user"
# - personal: Restricted to TELEGRAM_ADMIN_IDS and approved users.
# - multi-user: Anyone can search and browse; admin features remain restricted to TELEGRAM_ADMIN_IDS.
BOT_MODE=personal

# --- Storage & Database Settings ---
# Path to persistent SQLite database (supports ~ home expansion)
DATABASE_PATH=~/.media_aggregator/data.db

# --- Rate Limiting & Anti-Flood ---
# Cooldown interval (in seconds) between commands and button interactions per user
RATE_LIMIT_SECONDS=0.8

# --- Download Engine Settings ---
# Local directory where media files and .magnet files are saved
DOWNLOAD_DIR=~/Downloads/MediaAggregator

# Maximum concurrent background download jobs
MAX_CONCURRENT_DOWNLOADS=3

# Default maximum file size threshold for stream filtering (in Gigabytes)
DEFAULT_MAX_SIZE_GB=15.0

# Download buffer chunk size in Kilobytes (default: 1024 KB = 1 MB)
DOWNLOAD_CHUNK_SIZE_KB=1024

# --- Provider & Add-on Endpoints ---
# Base URL for Torrentio scraper add-on
DEFAULT_TORRENTIO_URL=https://torrentio.strem.fun

# Base URL for Cinemeta catalog and episode metadata
DEFAULT_CINEMETA_URL=https://v3-cinemeta.strem.io

# Optional Debrid Service API Keys for premium stream resolution
# DEFAULT_REALDEBRID_API_KEY=your_realdebrid_api_key_here
# DEFAULT_ALLDEBRID_API_KEY=your_alldebrid_api_key_here

# --- Logging Configuration ---
# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
